# Game data is never committed. Keep originals and dumps local only.
*.iso
*.cab
*.hdr
*.exe
*.dll
*.sys
*.TMP
*.tmp
*.bin
*.inx
*.isn
*.ibt
*.ini
*.inf
*.ico
*.wav
*.mp3
*.bik
*.bk2
*.dat
*.pak
*.ogg
*.tga
*.dds
*.xpr
dump/
extracted/
assets/original/
build/
*.keystore
*.jks
.venv/
__pycache__/
*.pyc
.DS_Store

# Agent worktrees (Claude Code)
.claude/worktrees/

# Build output, downloads and signing material are never committed.
artifacts/
*.apk
*.aab

# prebuilt/ holds preserved build inputs, not extracted game data. They belong in the
# repository (and the workflow uses them) only while it is private; keep them from being
# caught by the asset patterns above.
!prebuilt/libvt3android.so
!prebuilt/shaders.pack
!prebuilt/SHA256SUMS.txt
