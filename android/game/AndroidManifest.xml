<?xml version="1.0" encoding="utf-8"?>
<!-- Installer (Java) is the launcher: it unpacks the player's disc on first run, then starts the
     NativeActivity, which runs the game (native code). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="net.vt3port.game"
    android:versionCode="2"
    android:versionName="0.2.0">
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" android:version="1" />
    <!-- Optional, and never required: the setup screen works entirely through the Storage Access
         Framework, and this only adds the ability to read an already-unpacked game folder in place
         and to install to a folder of the player's choosing. It is a restricted permission on Google
         Play, so a store build drops it and keeps the SAF path (see docs/HANDOFF.md). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Vt3App starts the diagnostic log for every process launch, including a NativeActivity the
         system relaunches on its own after a process death. -->
    <application android:name="net.vt3port.game.Vt3App"
        android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:hasCode="true"
        android:debuggable="true" android:theme="@style/Theme.VT3">
        <activity android:name="net.vt3port.game.Installer"
            android:exported="true"
            android:configChanges="orientation|keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- Its own task, so opening it while the game runs never stacks a second game on top. -->
        <activity android:name="net.vt3port.game.Settings" android:exported="true"
            android:taskAffinity="" android:excludeFromRecents="true" />
        <!-- Settings -> Diagnostics: logs, the TXT report and its save/share actions. Not exported:
             only this app opens it. -->
        <activity android:name="net.vt3port.game.Diagnostics" android:exported="false"
            android:taskAffinity="" android:excludeFromRecents="true" />
        <!-- Reads back the report copy written to the app's own cache, for the share sheet. -->
        <provider android:name="net.vt3port.game.DiagFileProvider"
            android:authorities="net.vt3port.game.diagfiles"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Writes the thermal status marker while the game runs; the runtime lowers anisotropy as
             the phone heats, and the next launch moves the resolution one rung. -->
        <service android:name="net.vt3port.game.ThermalWatch" android:exported="false" />
        <!-- keyboard|navigation: connecting a pad or keyboard must not recreate the activity, which
             ends the game (APP_CMD_DESTROY) mid-match; the game takes the change as a resize. -->
        <activity android:name="android.app.NativeActivity"
            android:exported="false"
            android:theme="@style/Theme.VT3.Game"
            android:configChanges="orientation|keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:screenOrientation="sensorLandscape">
            <meta-data android:name="android.app.lib_name" android:value="vt3android" />
        </activity>
    </application>
</manifest>
