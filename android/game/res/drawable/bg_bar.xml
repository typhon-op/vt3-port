<?xml version="1.0" encoding="utf-8"?>
<!-- A menu bar, angled like the game's own rows: a silver plate with a slanted right edge and a
     hairline of shadow under it. Drawn as a vector so the slant is a real shape, not a tinted
     rectangle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="56dp"
    android:viewportWidth="320"
    android:viewportHeight="56">
    <path android:pathData="M6,3 L316,3 L308,53 L0,53 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="56"
                android:startColor="#FDFEFF"
                android:centerColor="#EEF2F6"
                android:endColor="#D2DAE2" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M6,3 L316,3"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4" />
    <path
        android:pathData="M0,53 L308,53"
        android:strokeColor="#8E9AA6"
        android:strokeWidth="1.2" />
    <path
        android:pathData="M6,3 L0,53"
        android:strokeColor="#E2571F"
        android:strokeWidth="3" />
</vector>
