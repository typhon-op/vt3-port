<?xml version="1.0" encoding="utf-8"?>
<!-- A translucent silver panel: the layered plate the game puts its menus and settings on. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F2FFFFFF"
                android:centerColor="#E6EDF2F7"
                android:endColor="#D9E2E9F0" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#B6C1CC" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp" android:left="10dp" android:right="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#CCFFFFFF" />
        </shape>
    </item>
</layer-list>
