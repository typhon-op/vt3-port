<?xml version="1.0" encoding="utf-8"?>
<!-- The row the player is on in the options list: the selection orange, with the pale edge the
     game puts on it and black text on top. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="48dp"
    android:viewportWidth="320"
    android:viewportHeight="48">
    <path android:pathData="M0,0 L320,0 L320,48 L0,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="48"
                android:startColor="#F58442"
                android:centerColor="#E2571F"
                android:endColor="#B33A0E" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M0,1 L320,1"
        android:strokeColor="#FFD9A0"
        android:strokeWidth="2" />
    <path
        android:pathData="M0,47 L320,47"
        android:strokeColor="#7E1605"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M0,0 L0,48"
        android:strokeColor="#FFD9A0"
        android:strokeWidth="4" />
</vector>
