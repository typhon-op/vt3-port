<?xml version="1.0" encoding="utf-8"?>
<!-- A pick button: the silver plate of a menu bar, edged in the selection orange. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33E2571F">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:endColor="#DCE3EA" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#E2571F" />
        </shape>
    </item>
</ripple>
