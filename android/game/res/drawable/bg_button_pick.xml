<?xml version="1.0" encoding="utf-8"?>
<!-- A pick button: the card's navy with the icon's red along its edge. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B2F58" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/vt3_red" />
        </shape>
    </item>
</ripple>
