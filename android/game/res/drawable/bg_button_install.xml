<?xml version="1.0" encoding="utf-8"?>
<!-- Install: the orange-red selection bar, greyed out until the plan can run. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/vt3_disabled" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#F07B3C"
                        android:centerColor="#E2571F"
                        android:endColor="#B33A0E" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
