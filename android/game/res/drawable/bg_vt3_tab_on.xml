<?xml version="1.0" encoding="utf-8"?>
<!-- The selected category tab: the selection orange, so the strip reads like the game's own. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="4dp" />
    <gradient
        android:angle="270"
        android:startColor="#F58442"
        android:endColor="#C0330C" />
    <stroke android:width="1dp" android:color="#FFD9A0" />
</shape>
