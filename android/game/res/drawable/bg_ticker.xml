<?xml version="1.0" encoding="utf-8"?>
<!-- The strip along the foot that setup's progress and messages sit in: silver panel, orange rule. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EAF0F5FA" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#C2CCD6" />
        </shape>
    </item>
    <item android:gravity="top" android:height="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/vt3_orange" />
        </shape>
    </item>
</layer-list>
