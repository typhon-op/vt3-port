<?xml version="1.0" encoding="utf-8"?>
<!-- The dark ground the game's own menus sit on: near-black at the foot, a warm red-brown at the
     top, so the red bars read as lit surfaces rather than floating rectangles. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#3A120A"
        android:centerColor="#240C07"
        android:endColor="#120504" />
</shape>
