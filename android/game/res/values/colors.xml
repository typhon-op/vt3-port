<?xml version="1.0" encoding="utf-8"?>
<!-- The Virtua Tennis 3 palette: pale silver and white backgrounds, translucent light-grey panels,
     orange-red selection bars, dark charcoal-brown text and gold accents. The names are the ones the
     launcher has always used, so every layout and every Java screen picks the theme up; the values
     are the VT3 menu palette rather than the old navy/blue. -->
<resources>
    <!-- Backgrounds: pale silver, a deeper silver for bars, and near-white for raised panels. -->
    <color name="vt3_page">#E7EBEF</color>
    <color name="vt3_page_deep">#C9D2DA</color>
    <color name="vt3_silver">#DCE2E8</color>
    <color name="vt3_silver_light">#F3F6F9</color>
    <color name="vt3_white">#FFFFFF</color>

    <!-- Panels: translucent silver, used behind menu lists and settings rows. -->
    <color name="vt3_panel">#E6F2F5F8</color>
    <color name="vt3_panel_solid">#F2F5F8</color>
    <color name="vt3_panel_strong">#F7FAFC</color>
    <color name="vt3_line">#AEB9C4</color>
    <color name="vt3_line_light">#D3DBE2</color>

    <!-- Text: dark charcoal on light panels, as the game's own menus print it. -->
    <color name="vt3_text">#2B2723</color>
    <color name="vt3_ink">#2B2723</color>
    <color name="vt3_ink_soft">#57504A</color>
    <color name="vt3_muted">#6E7278</color>
    <color name="vt3_text_on_bar">#FFFFFF</color>
    <color name="vt3_disabled">#B4BCC4</color>

    <!-- Selection and accents: orange-red bars, a deeper red for edges, gold for highlights. -->
    <color name="vt3_orange">#E2571F</color>
    <color name="vt3_orange_deep">#B33A0E</color>
    <color name="vt3_orange_light">#F07B3C</color>
    <color name="vt3_red">#E2571F</color>
    <color name="vt3_red_dark">#B33A0E</color>
    <color name="vt3_gold">#D9A03C</color>
    <color name="vt3_gold_light">#F0C878</color>

    <!-- Kept names: the ball colour is the gold accent, the blues are the cool grey-blue of the
         silver panels' shadows. -->
    <color name="vt3_ball">#D9A03C</color>
    <color name="vt3_ball_dark">#B7822A</color>
    <color name="vt3_blue">#4C6B85</color>
    <color name="vt3_blue_light">#6F8CA4</color>
    <color name="vt3_navy">#3E4A55</color>

    <!-- Surfaces. -->
    <color name="vt3_card">#F1F4F7</color>
    <color name="vt3_bar_fill">#F6F8FA</color>
    <color name="vt3_bar_edge">#B9C3CD</color>
    <color name="vt3_scrim">#33000000</color>
    <color name="vt3_shadow">#26000000</color>
</resources>
