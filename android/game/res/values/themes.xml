<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's screens. Platform Material only: the APK is packaged with aapt2 and d8 (see
     android/build_apk.py), so there is no AppCompat or other AndroidX library to lean on. -->
<resources>
    <style name="Theme.VT3" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vt3_page</item>
        <item name="android:statusBarColor">@color/vt3_page_deep</item>
        <item name="android:navigationBarColor">@color/vt3_page_deep</item>
        <item name="android:colorPrimary">@color/vt3_navy</item>
        <item name="android:colorPrimaryDark">@color/vt3_page_deep</item>
        <item name="android:colorAccent">@color/vt3_red</item>
        <item name="android:textColorPrimary">@color/vt3_text</item>
        <item name="android:textColorSecondary">@color/vt3_muted</item>
        <item name="android:buttonStyle">@style/Vt3Button</item>
    </style>

    <!-- The game itself: black behind the surface, nothing drawn over it. -->
    <style name="Theme.VT3.Game" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@color/vt3_ball</item>
    </style>

    <!-- A pick button: the card's navy with a red edge, as the icon's tile. -->
    <style name="Vt3Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_pick</item>
        <item name="android:textColor">@color/vt3_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.07</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- The one action that moves setup forward: the tennis ball's yellow-green. -->
    <style name="Vt3Button.Install" parent="@style/Vt3Button">
        <item name="android:background">@drawable/bg_button_install</item>
        <item name="android:textColor">@color/vt3_page_deep</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:minHeight">58dp</item>
    </style>

    <!-- One step of the setup: a card holding a numbered label, its explanation and its button. -->
    <style name="Vt3Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- The numbered badge in front of a step's label. -->
    <style name="Vt3StepNumber">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_step_number</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/vt3_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- A step's name, in the italic capitals the console-era tennis menus used. -->
    <style name="Vt3StepLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/vt3_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="Vt3StepHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">@color/vt3_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- What the step holds once its file has been picked. -->
    <style name="Vt3State">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/vt3_blue_light</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- The strip along the foot that setup's progress and messages sit in. -->
    <style name="Vt3Ticker">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_ticker</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Vt3Status">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/vt3_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
